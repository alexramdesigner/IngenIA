HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/ingenia.sqlite
# Generar con npm run setup; nunca copiar una contraseña de ejemplo.
PRESENTER_PASSWORD=
# En HTTPS establecer true. Local HTTP requiere false.
COOKIE_SECURE=false
TOKEN_TTL_SECONDS=28800
# Detrás de un proxy HTTPS de confianza, usar la IP real de X-Forwarded-For.
TRUST_PROXY=false
# Límites por minuto. En el auditorio cientos de celulares comparten la IP pública del Wi-Fi.
RATE_LIMIT_IP_PER_MIN=6000
RATE_LIMIT_CLIENT_PER_MIN=600
RATE_LIMIT_CREDENTIALS_PER_MIN=20
# Reinicio de sesión desde Studio (ensayos). Poner false el día del evento para bloquearlo.
ALLOW_SESSION_RESET=true
